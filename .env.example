# USSD Ticket Pay — copy to .env. Every integration defaults to MOCK / console.
# The API boots with this file unchanged. Sandbox keys are free and optional.
# See README "Free services & how to get each key".

# --- App ---
# Where: local only. Free. No signup.
NODE_ENV=development
PORT=3000
# SQLite file. Free, local. Use file:./prisma/dev.db
DATABASE_URL=file:./prisma/dev.db
LOG_LEVEL=info
# Comma-separated browser origins. Free, local.
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
# Public URL of this API (ngrok/Cloudflare URL when a sandbox must call you).
PUBLIC_BASE_URL=http://localhost:3000
# Web UI origin, used after PayPal returns.
WEB_APP_URL=http://localhost:5173
USSD_SERVICE_CODE=*384*123#
USSD_SESSION_TTL_SECONDS=120
USSD_PAGE_SIZE=3
# Shared secret for webhook authenticity (header X-Callback-Token, or ?token= on MTN).
# Free, you invent this string. Change it before any public deploy.
WEBHOOK_SECRET=dev-webhook-secret
# Header X-Admin-Secret for the dashboard simulate buttons. Local demo only.
ADMIN_SECRET=demo-admin
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
RECONCILE_CRON=*/1 * * * *
RECONCILE_AFTER_MINUTES=2
PAYMENT_EXPIRE_MINUTES=15
ENABLE_CRON=true

# --- MTN MoMo Collections SANDBOX (free, no card) ---
# Signup: https://momodeveloper.mtn.com/
# Subscribe to Collections, copy the Ocp-Apim-Subscription-Key (Primary key).
# Then run: npm run momo:setup
# Leave MTN_MODE=mock to skip all of this.
MTN_MODE=mock
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENV=sandbox
# Sandbox collections are billed in EUR, not RWF. This is an MTN sandbox rule.
MOMO_CURRENCY=EUR
# Demo conversion only (not a live FX rate). 5000 RWF -> about 4 EUR at 1400.
MOMO_RWF_PER_UNIT=1400
# Hostname only, no scheme. Used by `npm run momo:setup` as providerCallbackHost.
MOMO_CALLBACK_HOST=localhost

# --- Airtel Money Open API (free developer account; mock if keys are empty) ---
# Portal: https://developers.airtel.africa/
# Create an app, copy client id + secret. Country and currency MUST match the
# market enabled on that app. Many sandboxes use UG/UGX rather than RW/RWF.
AIRTEL_MODE=mock
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_COUNTRY=UG
AIRTEL_CURRENCY=UGX
AIRTEL_RWF_PER_UNIT=1

# --- PayPal Orders v2 SANDBOX (free, fake buyer accounts, no card on your side) ---
# Signup: https://developer.paypal.com/dashboard/
# Create a REST app and copy Sandbox client ID + secret.
PAYPAL_MODE=mock
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From the app's webhook (optional). When set, callbacks are verified with PayPal.
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
PAYPAL_RWF_PER_UNIT=1300

# --- Africa's Talking SMS SANDBOX (free simulator, not a real handset) ---
# Signup: https://account.africastalking.com/
# Sandbox app username is the literal word sandbox. Copy the sandbox API key.
SMS_MODE=console
AT_USERNAME=sandbox
AT_API_KEY=
AT_BASE_URL=https://api.sandbox.africastalking.com
# Optional. Sandbox often delivers without a custom sender id, into their simulator.
AT_SENDER_ID=

# --- Mock payments (default demo) ---
# pending: stay PENDING until the dashboard sends a webhook (best for recruiters)
# success | fail: settle immediately inside initiatePayment
MOCK_PAYMENT_RESULT=pending
MOCK_PAYMENT_DELAY_MS=0
